# Asoebi Fashion Week environment variables
#
# Copy the variables needed for local development into `.env.local`.
# Add production values through Vercel and the Convex production deployment.
# Never commit real keys, secrets, deployment credentials, or email API tokens.

# -----------------------------------------------------------------------------
# Convex connection
# -----------------------------------------------------------------------------

# Local development only. Generated by `bunx convex dev` and written to
# `.env.local`. Find the deployment reference in Convex Dashboard > project >
# deployment switcher. Do not add this variable to Vercel.
CONVEX_DEPLOYMENT=

# Vercel Production only. Generate this in Convex Dashboard > production
# deployment > Settings > Deploy Keys. Grant the `deployment:deploy` permission.
# This allows the Vercel build to deploy the Convex backend.
CONVEX_DEPLOY_KEY=

# Find both URLs in Convex Dashboard > deployment > Settings > URL & Deploy Key.
# Use the `*.convex.cloud` URL here. Use the development URL locally and the
# production URL in Vercel Production.
NEXT_PUBLIC_CONVEX_URL=

# Use the matching `*.convex.site` URL from the same Convex deployment.
# Do not mix development and production URLs. Omit the trailing slash.
NEXT_PUBLIC_CONVEX_SITE_URL=

# -----------------------------------------------------------------------------
# Resend email and newsletter audience
# -----------------------------------------------------------------------------

# Create in Resend Dashboard > API Keys. Vercel needs this for confirmation and
# notification emails. Convex also needs it for admin one-time-code emails.
RESEND_API_KEY=

# Optional. Create a full-access Resend key if RESEND_API_KEY cannot manage
# contacts and segments. Add to Vercel only when a separate key is required.
RESEND_CONTACTS_API_KEY=

# A verified sender from Resend Dashboard > Domains. Example:
# Asoebi Fashion Week <updates@asoebifw.com>
# Add the same value to Vercel and Convex.
RESEND_FROM_EMAIL=

# The monitored reply address used by transactional emails.
# Add the same value to Vercel and Convex.
RESEND_REPLY_TO=

# Copy the shared newsletter segment ID from Resend Dashboard > Audiences or
# Segments. Waitlist members and Prize applicants are added to this segment.
# Vercel only.
RESEND_WAITLIST_SEGMENT_ID=

# Destination for internal waitlist and Prize application notifications.
# Vercel only.
WAITLIST_NOTIFICATION_EMAIL=asoebifashionweek@gmail.com


# -----------------------------------------------------------------------------
# Better Auth runtime settings
# -----------------------------------------------------------------------------

# Convex environment variable, not a Vercel variable. Generate a different
# high-entropy secret for each deployment with `bunx auth secret` or
# `openssl rand -base64 32`. Set it in Convex Dashboard > deployment > Settings >
# Environment Variables.
BETTER_AUTH_SECRET=

# Convex environment variable, not a Vercel variable. For production use the
# canonical public website origin. For local development set this on the Convex
# development deployment to http://localhost:3000.
SITE_URL=https://asoebifw.com

# -----------------------------------------------------------------------------
# Optional content and monitoring integrations
# -----------------------------------------------------------------------------

# Find these in Sanity Manage > project > API. Add to Vercel and `.env.local`
# only when Sanity-backed content is enabled.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Find the DSN in Sentry > project > Settings > Client Keys. Add to Vercel and
# `.env.local` when production monitoring is enabled.
NEXT_PUBLIC_SENTRY_DSN=

# Create in Sentry > Settings > Auth Tokens with source-map upload permission.
# Vercel only. Keep empty when source-map uploads are not configured.
SENTRY_AUTH_TOKEN=
